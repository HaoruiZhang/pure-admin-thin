# 平台本地运行端口号
VITE_PORT = 8848
VITE_ENV_MODE = "dev"
# 开发环境读取配置文件路径
VITE_PUBLIC_PATH = 'pure_dev'

# 开发环境路由历史模式（Hash模式传"hash"、HTML5模式传"h5"、Hash模式带base参数传"hash,base参数"、HTML5模式带base参数传"h5,base参数"）
VITE_ROUTER_HISTORY = "hash"

# 是否隐藏首页 隐藏 true 不隐藏 false （勿删除，VITE_HIDE_HOME只需在.env文件配置）
VITE_HIDE_HOME = true

# StereoAgent 配置
VITE_SHOW_MORE_SETTING = false

# StereoAgent 配置
VITE_URL_AGENT_BACKEND = 'http://172.19.196.165:39999/addon'

# ADK 平台配置
VITE_URL_ADK_HOST = 'http://172.19.196.165:8002'

# 服务端点
VITE_URL_HOST = 'http://172.19.196.165'
